{
  "name": "flowlace",
  "productName": "Flowlace",
  "version": "1.5.1",
  "description": "Flowlace — projects, deliverables, tasks and resources (desktop app for Windows)",
  "main": "src/main/main.js",
  "author": "Alphazeta Group",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "node scripts/build-renderer.js && electron-forge start",
    "test": "node --test test/store.test.js test/server.test.js",
    "test:ui": "node scripts/build-renderer.js && node test/e2e/run-all.js",
    "package:win": "electron-forge package --platform win32 --arch x64",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "server:dist": "node scripts/build-server-dist.js",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "electron": "43.7.7",
    "playwright-core": "1.63.0"
  }
}
